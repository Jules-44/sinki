{
  "name": "sinki-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @sinki/server dev",
    "dev:client": "pnpm --filter @sinki/client dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @sinki/server start",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
